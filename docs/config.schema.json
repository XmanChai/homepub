{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "homepub config",
  "type": "object",
  "required": [
    "domain",
    "server",
    "services"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "description": "root domain, e.g. example.com"
    },
    "server": {
      "type": "object",
      "required": [
        "addr"
      ],
      "additionalProperties": false,
      "properties": {
        "addr": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 7000
        },
        "tokenEnv": {
          "type": "string",
          "default": "FRP_TOKEN"
        },
        "bindAddr": {
          "type": "string",
          "default": "127.0.0.1"
        }
      }
    },
    "tunnel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "portStart": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 18081
        },
        "portEnd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 18099
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "out": {
          "type": "string",
          "default": "./out"
        },
        "ledger": {
          "type": "string",
          "default": "./ports.json"
        },
        "frpcConfig": {
          "type": "string",
          "default": "/etc/frp/frpc.toml"
        },
        "nginxConfDir": {
          "type": "string",
          "default": "/etc/nginx/conf.d"
        },
        "nginxCertsDir": {
          "type": "string",
          "default": "/etc/nginx/certs"
        },
        "acmeHome": {
          "type": "string",
          "default": "/root/.acme.sh"
        },
        "acmeWebroot": {
          "type": "string",
          "default": "/var/www/acme"
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "localPort"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "subdomain": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "localHost": {
            "type": "string",
            "default": "127.0.0.1"
          },
          "localPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "healthPath": {
            "type": "string",
            "default": "/"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "http",
              "https"
            ],
            "default": "http"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
