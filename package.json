{
  "name": "homepub",
  "version": "0.1.0",
  "description": "Publish self-hosted services to the internet with one command: frp + nginx + ACME, generated and drift-checked.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "homepub": "bin/homepub.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\"",
    "demo": "node bin/homepub.js plan --config examples/homepub.config.json",
    "test:e2e": "bash scripts/e2e-install.sh out-example"
  },
  "keywords": [
    "frp",
    "self-hosted",
    "homelab",
    "nginx",
    "acme",
    "reverse-proxy",
    "tunnel"
  ]
}
